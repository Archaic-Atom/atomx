Screen { background: $arc-background; color: $arc-foreground; }
ArcatomApp { background: $arc-background; }
#brand { height: 3; padding: 0 2; margin-top: 1; }
#connection { height: 1; padding: 0 2; color: $arc-muted; }
#view { height: 1fr; padding: 0 2; }
.muted { color: $arc-muted; }
#overview { height: 1; color: $arc-accent; }
Input { background: $arc-surface; border: tall $arc-border; color: $arc-foreground; }
Input:focus { border: tall $arc-accent; }
#search { height: 5; min-height: 5; border: round $arc-border; padding: 1 1; margin: 1 0 0 0; }
#search:focus { border: round $arc-accent; background: $arc-selection; }
OptionList { background: $arc-background; border: none; padding: 0; }
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $arc-selection; color: $arc-foreground; text-style: none; }
OptionList:focus > .option-list--option-highlighted { background: $arc-selection; color: $arc-foreground; }
#sessions { height: 1fr; }
#session-columns { height: 1; padding: 0 1; }
#home-hint { height: 1; padding: 0; }
#bottom { dock: bottom; height: auto; min-height: 1; max-height: 4; padding: 0 2; border: none; background: $arc-surface; }
#chat-title { height: 1; text-style: bold; }
#chat-path { height: 1; }
#transcript-scroll { height: 1fr; scrollbar-size: 1 1; }
#transcript { height: auto; padding-right: 1; }
#waiting { height: 1; color: $arc-accent; }
#activity-summary { height: 1; padding-top: 0; color: $arc-accent; }
#activities { height: auto; max-height: 9; border-left: solid $arc-border; margin-bottom: 1; }
#activities > .option-list--option { padding: 0 1; }
#composer { height: 3; min-height: 3; border: round $arc-border; background: $arc-surface; color: $arc-foreground; padding: 0 1; }
#composer:focus { border: round $arc-accent; }
#chat-hint { height: 1; }
ModalScreen { align: center middle; background: #000000 60%; }
#dialog { width: 85%; max-width: 110; height: 85%; background: $arc-surface; border: round $arc-accent; padding: 1 2; }
#small-dialog { width: 80%; max-width: 90; height: auto; background: $arc-surface; border: round $arc-accent; padding: 1 2; }
#dialog-title { height: auto; max-height: 8; margin-bottom: 1; color: $arc-accent; text-style: bold; }
#detail-scroll { height: 1fr; }
#detail-body { height: auto; }
#dialog-actions { height: 3; margin-top: 1; }
Button { background: $arc-selection; border: none; margin-right: 2; }
Button:focus { text-style: bold; tint: $arc-accent 20%; }
#answers { height: 1fr; }
Screen.compact #brand { height: 3; padding-top: 0; }
Screen.compact #connection { height: 1; }
Screen.compact #chat-path { height: 1; }
Screen.compact #chat-title { height: 1; }
.command-menu { height: auto; max-height: 8; border: round $arc-border; background: $arc-surface; margin-bottom: 1; }
.command-menu > .option-list--option { padding: 0 1; }
#choices { height: 1fr; margin-top: 1; }
Screen.compact .command-menu { max-height: 6; }

#home-actions { height: 1; margin: 0; }
#home-actions Button { min-width: 20; height: 1; min-height: 1; padding: 0 1; margin-right: 2; background: $arc-background; color: $arc-accent; }
#home-actions Button:focus { background: $arc-selection; }
#sessions > .option-list--option-disabled { color: $arc-foreground; }
#settings-scroll { height: 1fr; }
.setting-label { height: auto; margin-top: 1; }
.setting-description { height: auto; margin-bottom: 1; }
.setting-row { height: 3; align-vertical: middle; }
.setting-row Static { width: 1fr; height: 1; }
.setting-row Switch { width: auto; }
#palette-preview { height: 2; padding-top: 1; }
#transcript-scroll:focus { border-left: solid $arc-accent; }
Screen.compact #home-actions { margin-bottom: 0; }
Screen.compact #search { margin-bottom: 0; }
Screen.compact #home-hint { height: 1; padding-top: 0; }
Screen.chat-view #brand { height: 1; margin-top: 0; }
Select { background: $arc-surface; color: $arc-foreground; }
SelectCurrent { background: $arc-surface; color: $arc-foreground; }

#attachments { height: auto; max-height: 2; color: $arc-accent; }

DirectoryInput:focus { border: round $arc-accent; }
DirectoryInput.editing { background: $arc-selection; }

#older-history { height: 1; min-height: 1; color: $arc-accent; background: $arc-background; }
