#!/bin/sh
# Resolve the project without changing the caller's working directory.
ARCATOM_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$ARCATOM_ROOT/.venv/bin/python" ]; then
    echo "请先在项目目录运行：python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
    exit 1
fi
export PYTHONPATH="$ARCATOM_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$ARCATOM_ROOT/.venv/bin/python" -m arcatom_codex "$@"
