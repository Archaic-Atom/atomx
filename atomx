#!/bin/sh
# Resolve the checkout without changing the caller's working directory.
ATOMX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$ATOMX_ROOT/.venv/bin/python" ]; then
    echo "Run in the checkout: python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.lock" >&2
    exit 1
fi
export PYTHONPATH="$ATOMX_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$ATOMX_ROOT/.venv/bin/python" -m arcatom_codex "$@"
